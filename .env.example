# ---------------------------------------------------------------------------
# Provider selection: offline | azure | openai
#
# offline (default) needs NO keys and NO network. Every pattern runs from a
# deterministic scripted client, so the session survives conference wifi.
# ---------------------------------------------------------------------------
CHAOS_PROVIDER=offline

# --- azure -----------------------------------------------------------------
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
# Leave unset to use the framework's default. Pin it only if your resource
# rejects that one ("API version not supported") - `make check` finds a good one.
# AZURE_OPENAI_API_VERSION=2024-12-01-preview

# --- openai ----------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- ports -----------------------------------------------------------------
DEVUI_PORT=8080
SHOWCASE_PORT=8000

# Set to 1 to stream OpenTelemetry spans into the showcase log panel.
CHAOS_TELEMETRY=1

# Every DevUI workflow takes a prompt, the way the showcase's "Run it" box does.
# Set to 0 for DevUI's own input widgets - a role/contents form on the eight
# patterns built with an orchestration builder.
CHAOS_DEVUI_PROMPT_INPUT=1

# --- foundry (Foundry Agent Service) ----------------------------------------
FOUNDRY_PROJECT_ENDPOINT=
FOUNDRY_MODEL=

# --- container / Azure ------------------------------------------------------
# Serve DevUI through this app instead of its own port (single-origin deploys).
CHAOS_PROXY_DEVUI=0
# Bind address. 0.0.0.0 in a container; loopback locally.
CHAOS_HOST=127.0.0.1
